{
  "name": "wave-gesture-player",
  "productName": "Wave",
  "description": "Touchless hand-gesture controller for videos, reels, shorts and music",
  "author": "Wave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test-gestures.ts",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "clsx": "2.1.1",
    "lucide-react": "^1.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "build": {
    "appId": "app.wave.gesture",
    "productName": "Wave",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**/*",
      "node_modules/@nut-tree-fork/libnut*/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "Wave uses the camera to see your hand gestures. Video never leaves your device.",
        "NSAccessibilityUsageDescription": "Wave needs Accessibility access to press media keys in other apps."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Wave <wave@example.com>"
    }
  }
}
